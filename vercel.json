{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/docs/contacts-and-calendar", "destination": "/docs/contacts", "permanent": true },
    { "source": "/pt/docs/contacts-and-calendar", "destination": "/pt/docs/contacts", "permanent": true },
    { "source": "/docs/certificates-and-encrypted-cache", "destination": "/docs/certificates", "permanent": true },
    { "source": "/pt/docs/certificates-and-encrypted-cache", "destination": "/pt/docs/certificates", "permanent": true },
    { "source": "/docs/calendar", "destination": "/docs/faq", "permanent": false },
    { "source": "/pt/docs/calendar", "destination": "/pt/docs/faq", "permanent": false },
    { "source": "/md/:path*", "destination": "/:path*", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(shots|brand|og|media)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }]
    },
    {
      "source": "/(llms.txt|llms-full.txt|robots.txt)",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/releases.xml",
      "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }]
    },
    {
      "source": "/(.*)manifest.webmanifest",
      "headers": [{ "key": "Content-Type", "value": "application/manifest+json" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-G1eQHqwUsYX4SkQdYZ4+L4p/eP+N/7Tq7am1lx32clg='; style-src 'self' 'sha256-mCrBX8lQ7T7xuXd+/64+z6S6mxli9Ym0pIqSH+gw8Y4='; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; manifest-src 'self'; worker-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'; upgrade-insecure-requests" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()" }
      ]
    }
  ]
}
