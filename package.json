{
  "name": "komorebi-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Website and documentation for Komorebi, deployed to komorebi.rusticstack.com",
  "license": "GPL-3.0-or-later",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "upstream": "node scripts/upstream.mjs",
    "sync:upstream": "node scripts/upstream.mjs --snapshot",
    "og": "node scripts/render-og.mjs",
    "images": "node scripts/prepare-images.mjs",
    "dev": "pnpm upstream && astro dev",
    "build": "pnpm upstream && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "check:links": "node scripts/check-links.mjs dist",
    "check:seo": "node scripts/check-seo.mjs dist",
    "words": "node scripts/word-count.mjs"
  },
  "dependencies": {
    "@ui-sdk/core": "0.1.0-beta.1",
    "@ui-sdk/web": "0.1.0-beta.1",
    "astro": "^7.4.2",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^24.19.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
