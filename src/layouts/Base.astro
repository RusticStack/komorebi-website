---
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { HTML_LANG, OG_LOCALE, localePath, ui, type Locale } from "../lib/i18n";
import { absolute, organization, type JsonLd } from "../lib/seo";
import { SITE_NAME } from "../lib/site";

interface Props {
  locale: Locale;
  /** The page's path without the language prefix: "/", "/docs/rules". */
  path: string;
  title: string;
  description: string;
  /** The Open Graph card in public/og/<locale>/<og>.png. */
  og: string;
  jsonLd?: JsonLd[];
  current?: "docs" | "privacy" | "download" | null;
  noindex?: boolean;
  /** Images to preload (only the home page's product picture). */
  preload?: { srcset: string; sizes: string; type: string; media: string }[];
  ogType?: "website" | "article";
}

const { locale, path, title, description, og, jsonLd = [], current = null, noindex = false, preload = [], ogType = "website" } = Astro.props;
const t = ui(locale);
const canonical = absolute(localePath(locale, path));
const ogImage = absolute(`/og/${locale}/${og}.png`);
const other: Locale = locale === "en" ? "pt" : "en";
const graph = [...jsonLd, organization()];
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {
      !noindex && (
        <>
          <link rel="alternate" hreflang="en" href={absolute(localePath("en", path))} />
          <link rel="alternate" hreflang="pt-PT" href={absolute(localePath("pt", path))} />
          <link rel="alternate" hreflang="x-default" href={absolute(localePath("en", path))} />
        </>
      )
    }
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href={locale === "pt" ? "/pt/manifest.webmanifest" : "/manifest.webmanifest"} />
    <link rel="alternate" type="application/rss+xml" title={locale === "pt" ? "Versões do Komorebi" : "Komorebi releases"} href="/releases.xml" />
    {preload.map((p) => <link rel="preload" as="image" imagesrcset={p.srcset} imagesizes={p.sizes} type={p.type} media={p.media} fetchpriority="high" />)}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[other]} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      // marks that the script can run, so the theme toggle and the search show from the first frame
      document.documentElement.classList.add("js");
      try {
        var t = localStorage.getItem("theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    {graph.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script src="/site.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header locale={locale} path={path} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} />
  </body>
</html>
