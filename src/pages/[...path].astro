---
// Every page in both languages. English lives at the root, European Portuguese under /pt.
import type { GetStaticPaths } from "astro";
import Home from "../views/Home.astro";
import Download from "../views/Download.astro";
import DocsHome from "../views/DocsHome.astro";
import DocPage from "../views/DocPage.astro";
import Privacy from "../views/Privacy.astro";
import Changelog from "../views/Changelog.astro";
import CodeSigning from "../views/CodeSigning.astro";
import About from "../views/About.astro";
import { DOC_SLUGS } from "../lib/docs";
import { LOCALES, type Locale } from "../lib/i18n";

export const getStaticPaths = (() => {
  const views = ["home", "download", "docs", "privacy", "changelog", "code-signing", "about"];
  return LOCALES.flatMap((locale) => {
    const prefix = locale === "pt" ? "pt" : "";
    const join = (rest: string) => [prefix, rest].filter(Boolean).join("/") || undefined;
    return [
      ...views.map((view) => ({ params: { path: join(view === "home" ? "" : view) }, props: { locale, view, slug: "" } })),
      ...DOC_SLUGS.map((slug) => ({ params: { path: join(`docs/${slug}`) }, props: { locale, view: "doc", slug } })),
    ];
  });
}) satisfies GetStaticPaths;

const { locale, view, slug } = Astro.props as { locale: Locale; view: string; slug: string };
---

{view === "home" && <Home locale={locale} />}
{view === "download" && <Download locale={locale} />}
{view === "docs" && <DocsHome locale={locale} />}
{view === "doc" && <DocPage locale={locale} slug={slug} />}
{view === "privacy" && <Privacy locale={locale} />}
{view === "changelog" && <Changelog locale={locale} />}
{view === "code-signing" && <CodeSigning locale={locale} />}
{view === "about" && <About locale={locale} />}
