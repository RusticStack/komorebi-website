---
// The room on each help page for a screen recording of the app doing what the page says, in the
// site's player, under the page's lede. It shows nothing until the recording exists:
//
//   public/media/guides/<slug>.webm   (and/or .mp4)   the recording, English interface
//   public/media/guides/<slug>.webp or .jpg           its poster (`pnpm posters` makes the .webp)
//   public/media/guides/<slug>.vtt                    captions, when there are any
//   public/media/guides/<slug>.pt.*                   the same for the Portuguese pages
//
// A Portuguese page uses the .pt recording when it exists, and the English one otherwise.
// Recordings are 1280 x 800 (16:10, the app's window) unless they are 16:9; the player's box is
// fixed to that ratio. It loads nothing until it is pointed at, and plays when pressed.
import Player from "./Player.astro";
import { ui, type Locale } from "../lib/i18n";
import { findMedia } from "../lib/media";

interface Props {
  slug: string;
  locale: Locale;
  /** The page's title, for the caption and the accessible name. */
  title: string;
  width?: number;
  height?: number;
}
const { slug, locale, title, width = 1280, height = 800 } = Astro.props;
const t = ui(locale);
const media = findMedia(`guides/${slug}`, locale);
const label = t.guideVideo.replace("{title}", title);
---

{
  media && (
    <figure class="guide-video">
      <Player media={media} locale={locale} label={label} title={title} mode="guide" width={width} height={height} />
      <figcaption class="cap">{label}</figcaption>
    </figure>
  )
}
