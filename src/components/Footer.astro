---
import Logo from "./Logo.astro";
import { localePath, ui, type Locale } from "../lib/i18n";
import { REPO_URL, SITE_REPO_URL } from "../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const p = (path: string) => localePath(locale, path);
---

<div class="wrap">
  <footer class="foot">
    <a class="home" href={p("/")} aria-label={t.home}><Logo kind="wordmark" /></a>
    <nav aria-label={t.footerLinks}>
      <ul>
        <li class="phone-only"><a href={p("/docs")}>{t.help}</a></li>
        <li class="phone-only"><a href={p("/privacy")}>{t.privacy}</a></li>
        <li class="phone-only"><a href={REPO_URL} rel="noopener">{t.source}</a></li>
        <li><a href={p("/changelog")}>{t.changelog}</a></li>
        <li><a href={p("/code-signing")}>{t.codeSigning}</a></li>
        <li><a href={p("/about")}>{t.about}</a></li>
        <li><a href={SITE_REPO_URL} rel="noopener">{t.siteSource}</a></li>
      </ul>
    </nav>
    <p>{t.footerFree}</p>
    <p>{t.footerTracking}</p>
  </footer>
</div>
