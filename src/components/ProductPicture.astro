---
// The product picture on the home page, in the light and the dark theme; CSS shows the one that
// matches the page's theme. The files are made by scripts/prepare-images.mjs.
//
// PLACEHOLDER: these are the brand mockup renders of the inbox (F:\Projects\komorebi-brand\final\
// app\png), not screenshots. Replace them with real screenshots of the GPUI app when it exists;
// see docs/TODO-SCREENSHOTS.md. Until then the alt text and the caption say "design preview".
import { COMPACT_SIZES, PHONE, WIDE_SIZES, srcset } from "../lib/preview";

interface Props {
  alt: string;
}
const { alt } = Astro.props;
---

{
  ["light", "dark"].map((theme) => (
    <picture class={`pic-${theme}`}>
      <source media={PHONE} type="image/avif" srcset={srcset(theme, "compact", "avif")} sizes={COMPACT_SIZES} width="900" height="700" />
      <source media={PHONE} type="image/webp" srcset={srcset(theme, "compact", "webp")} sizes={COMPACT_SIZES} width="900" height="700" />
      <source type="image/avif" srcset={srcset(theme, "wide", "avif")} sizes={WIDE_SIZES} />
      <img
        src={`/preview/inbox-${theme}-wide-1312.webp`}
        srcset={srcset(theme, "wide", "webp")}
        sizes={WIDE_SIZES}
        width="1280"
        height="800"
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    </picture>
  ))
}
