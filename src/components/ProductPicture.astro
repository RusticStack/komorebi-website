---
// The product picture on the home page, in the light and the dark theme; CSS shows the one that
// matches the page's theme. The files are made by scripts/prepare-images.mjs.
//
// `large` is the copy in the lightbox dialog: the wide picture only, at up to the full width of
// the window, loaded when the dialog first shows it.
import { COMPACT_SIZES, PHONE, WIDE_SIZES, srcset } from "../lib/preview";

interface Props {
  alt: string;
  large?: boolean;
}
const { alt, large = false } = Astro.props;
const wideSizes = large ? "min(100vw, 100rem)" : WIDE_SIZES;
---

{
  ["light", "dark"].map((theme) => (
    <picture class={`pic-${theme}`}>
      {!large && <source media={PHONE} type="image/avif" srcset={srcset(theme, "compact", "avif")} sizes={COMPACT_SIZES} width="900" height="700" />}
      {!large && <source media={PHONE} type="image/webp" srcset={srcset(theme, "compact", "webp")} sizes={COMPACT_SIZES} width="900" height="700" />}
      <source type="image/avif" srcset={srcset(theme, "wide", "avif")} sizes={wideSizes} />
      <img
        src={`/preview/inbox-${theme}-wide-1312.webp`}
        srcset={srcset(theme, "wide", "webp")}
        sizes={wideSizes}
        width="1280"
        height="800"
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    </picture>
  ))
}
