---
// The product picture in the home page's hero: the Komorebi 1.0 inbox with a newsletter open, in
// the light and the dark theme; CSS shows the one that matches the page's theme. On a phone it is
// the window's left half (the folders and the message list). The files are made by
// scripts/prepare-images.mjs.
//
// The picture is the page's largest element, so it loads eagerly and at high priority. Both
// themes are in the markup, and a hidden image still downloads when it is eager, so each picture
// starts with a "guard": a source for the other theme's system setting that points at a 1 x 1
// data: image. On a light system the dark picture shows the blank image and the light one its
// real files, and the other way round on a dark system. When the visitor has chosen a theme that
// differs from the system's, src/scripts/site.ts switches the guards over.
//
// `large` is the copy in the lightbox dialog: the wide picture only, at up to the full width of
// the window, loaded when the dialog first shows it.
import { BLANK, HERO_PHONE_SIZES, HERO_SIZES, PHONE, fallback, srcset, type Theme } from "../lib/shots";

interface Props {
  alt: string;
  large?: boolean;
}
const { alt, large = false } = Astro.props;
const sizes = large ? "min(100vw, 80rem)" : HERO_SIZES;
const themes: Theme[] = ["light", "dark"];
---

{
  themes.map((theme) => (
    <picture class={`pic-${theme}`}>
      {!large && <source data-guard={theme} media={`(prefers-color-scheme: ${theme === "light" ? "dark" : "light"})`} srcset={BLANK} />}
      {!large && <source media={PHONE} type="image/avif" srcset={srcset("hero-phone", theme, "avif")} sizes={HERO_PHONE_SIZES} width="656" height="800" />}
      {!large && <source media={PHONE} type="image/webp" srcset={srcset("hero-phone", theme, "webp")} sizes={HERO_PHONE_SIZES} width="656" height="800" />}
      <source type="image/avif" srcset={srcset("hero", theme, "avif")} sizes={sizes} />
      <img
        src={fallback("hero", theme)}
        srcset={srcset("hero", theme, "webp")}
        sizes={sizes}
        width="1280"
        height="800"
        alt={alt}
        loading={large ? "lazy" : "eager"}
        fetchpriority={large ? undefined : "high"}
        decoding="async"
      />
    </picture>
  ))
}
