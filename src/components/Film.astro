---
// The launch film (the brand folder's launch/LAUNCH.md): 40 seconds made from the storyboard
// frames, silent, 400 ms cross-fades. The section, with whatever is passed in its slot (the
// heading), renders only when public/media/komorebi-film.webm or .mp4 exists. It is muted, plays
// inline, shows its poster and loads nothing until it is played (preload="none"). The film's
// words are in the picture; they also ship as a caption track per language
// (public/media/komorebi-film.<locale>.vtt) for screen readers, off by default so they are not
// shown twice.
import { existsSync } from "node:fs";
import { join } from "node:path";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  label: string;
}
const { locale, label } = Astro.props;
const media = (name: string) => existsSync(join(process.cwd(), "public", "media", name));
const sources = [
  { file: "komorebi-film.webm", type: "video/webm" },
  { file: "komorebi-film.mp4", type: "video/mp4" },
].filter((s) => media(s.file));
const captions = media(`komorebi-film.${locale}.vtt`) ? `/media/komorebi-film.${locale}.vtt` : null;
const poster = media("komorebi-film-poster.webp") ? "/media/komorebi-film-poster.webp" : undefined;
---

{
  sources.length > 0 && (
    <section class="film-block" aria-label={label} data-reveal>
      <slot />
      <div class="window film-window">
        <video class="film" controls muted playsinline preload="none" poster={poster} width="1920" height="1080" aria-label={label}>
          {sources.map((s) => (
            <source src={`/media/${s.file}`} type={s.type} />
          ))}
          {captions && <track kind="captions" src={captions} srclang={locale === "pt" ? "pt-PT" : "en"} label={locale === "pt" ? "Português" : "English"} />}
        </video>
      </div>
    </section>
  )
}
