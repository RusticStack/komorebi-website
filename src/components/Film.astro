---
// The launch film's section on the home page: its heading and one line (the slot), the film on a
// canvas stage in the site's player, and one line under it. It renders only when
// public/media/komorebi-film.webm or .mp4 exists (see src/lib/media.ts for the file names: the
// poster komorebi-film.webp or .jpg, captions komorebi-film.vtt and .pt.vtt, and .pt videos).
// The film plays itself, muted and looping, while it is on screen, and pauses off screen; with
// reduced motion it waits for a press. Its words are in the picture, so the captions are off until
// turned on.
import Player from "./Player.astro";
import type { Locale } from "../lib/i18n";
import { findMedia } from "../lib/media";

interface Props {
  locale: Locale;
  /** The film's accessible name. */
  label: string;
  /** The line under the film. */
  caption: string;
}
const { locale, label, caption } = Astro.props;
const media = findMedia("komorebi-film", locale);
---

{
  media && (
    <section class="film-block" aria-labelledby="film-title" data-reveal>
      <slot />
      <div class="film-stage">
        <Player media={media} locale={locale} label={label} title={label} mode="film" width={1920} height={1080} />
      </div>
      <p class="cap">{caption}</p>
    </section>
  )
}
