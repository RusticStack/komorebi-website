---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import { localePath, ui, type Locale } from "../lib/i18n";
import { breadcrumbs, softwareApplication } from "../lib/seo";
import { LATEST_RELEASE_URL } from "../lib/site";
import { downloadHref, fileSize, formatDate, getRelease, installerSize } from "../lib/upstream";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const pt = locale === "pt";
const p = (path: string) => localePath(locale, path);
const release = getRelease();
const installer = release?.installer ?? null;
const size = installerSize(locale);
const portable = release?.portable ?? null;
const releasePage = release?.htmlUrl ?? LATEST_RELEASE_URL;
const sums = release?.sha256sumsUrl ?? null;
const placeholder = pt ? "<versão>" : "<version>";
// The two ways a release comes, from 1.0 on: the installer and the portable zip. A release
// without a zip (0.7 and older) shows the installer only.
const options = [
  {
    key: "installer",
    title: pt ? "Instalador" : "Installer",
    name: installer?.name ?? `komorebi-${placeholder}-setup.exe`,
    href: downloadHref(),
    size: installerSize(locale),
    sha256: installer?.sha256 ?? null,
    text: pt
      ? "Instala o komorebi.exe para o seu utilizador do Windows, sem direitos de administrador, com um atalho no menu Iniciar. Atualiza-se a partir de Definições > Acerca de."
      : "Installs komorebi.exe for your Windows user, with no administrator rights, and adds a Start menu shortcut. It updates itself from Settings > About.",
  },
  {
    key: "portable",
    title: pt ? "Zip portátil" : "Portable zip",
    name: portable?.name ?? `komorebi-${placeholder}-portable-x64.zip`,
    href: portable?.url ?? releasePage,
    size: fileSize(portable, locale),
    sha256: portable?.sha256 ?? null,
    text: pt
      ? "O komorebi.exe com a licença, a declaração de privacidade e o registo de alterações. Descompacte-o onde quiser e execute-o; os dados ficam em %LOCALAPPDATA%\\komorebi, como na aplicação instalada."
      : "komorebi.exe with the licence, the privacy statement and the changelog. Unzip it anywhere and run it; it keeps its data in %LOCALAPPDATA%\\komorebi, as the installed app does.",
  },
].filter((option) => option.key === "installer" || portable || !release);
const title = pt ? "Transferir o Komorebi para Windows" : "Download Komorebi for Windows";
const description = pt
  ? "Transfira o Komorebi para Windows 10 e 11: o instalador ou o zip portátil, o SHA-256, os requisitos e o que esperar do Windows SmartScreen."
  : "Download Komorebi for Windows 10 and 11: the installer or the portable zip, the SHA-256, the requirements and what to expect from Windows SmartScreen.";
---

<Base
  locale={locale}
  path="/download"
  title={title}
  description={description}
  og="download"
  current="download"
  jsonLd={[softwareApplication(locale), breadcrumbs([{ name: "Komorebi", path: p("/") }, { name: t.download, path: p("/download") }])]}
>
  <div class="wrap">
    <section class="dl" aria-labelledby="title">
      <Logo kind="seal" />
      <h1 id="title">{pt ? "Transferir o Komorebi" : "Download Komorebi"}</h1>
      <ul class="meta">
        {release && <li>{pt ? `Versão ${release.version}` : `Version ${release.version}`}</li>}
        {size && <li>{size}</li>}
        <li>{pt ? "Windows 10 e 11, 64 bits" : "Windows 10 and 11, 64-bit"}</li>
        {release && <li>{pt ? `Publicada a ${formatDate(release.publishedAt, locale)}` : `Released ${formatDate(release.publishedAt, locale)}`}</li>}
      </ul>
      <div class="cta">
        <a class="btn" href={downloadHref()}>{t.downloadForWindows}</a>
        <p class="fine">
          {pt ? "Instala-se para o seu utilizador do Windows, sem direitos de administrador." : "Installs for your Windows user, with no administrator rights."}
        </p>
      </div>
    </section>

    <section class="options" aria-labelledby="options">
      <h2 id="options">{pt ? "Escolha como o quer" : "Choose how you want it"}</h2>
      <div class="option-list">
        {
          options.map((option) => (
            <div class="option" id={option.key}>
              <h3>{option.title}</h3>
              <p class="option-text">{option.text}</p>
              <p class="option-file">
                <a href={option.href}>{option.name}</a>
                {option.size && <span class="fine"> {option.size}</span>}
              </p>
              {option.sha256 && (
                <p class="fine">
                  SHA-256
                  <code class="hash">{option.sha256}</code>
                </p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <div class="grid2">
      <section aria-labelledby="smartscreen">
        <h2 id="smartscreen">{pt ? "Antes de o executar" : "Before you run it"}</h2>
        <div class="prose">
          {
            pt ? (
              <p>
                O instalador ainda não tem assinatura Authenticode, por isso o Windows SmartScreen pode mostrar um aviso na primeira vez. Confirme o SHA-256 e escolha <strong>Mais informações</strong> e <strong>Executar mesmo assim</strong>. <a href={p("/code-signing")}>Política de assinatura de código</a>.
              </p>
            ) : (
              <p>
                The installer is not Authenticode-signed yet, so Windows SmartScreen may warn the first time. Check the SHA-256, then choose <strong>More info</strong> and <strong>Run anyway</strong>. <a href={p("/code-signing")}>Code signing policy</a>.
              </p>
            )
          }
        </div>
      </section>

      <section aria-labelledby="check">
        <h2 id="check">{pt ? "Verificar o ficheiro" : "Check the file"}</h2>
        <div class="prose">
          <p>
            {pt ? "Cada versão traz o SHA-256 de todos os seus ficheiros em " : "Every release lists the SHA-256 of each of its files in "}
            {sums ? <a href={sums}>SHA256SUMS</a> : <a href={releasePage}>SHA256SUMS</a>}
            {pt ? ". No PowerShell, na pasta da transferência, o resultado de" : ". In PowerShell, in the download folder, the result of"}
          </p>
          <pre><code>{`(Get-FileHash .\\${options[0].name}).Hash.ToLower()`}</code></pre>
          <p>{pt ? "tem de ser igual ao valor desse ficheiro. Se for diferente, apague o ficheiro e transfira-o de novo." : "must match the value for that file. If it differs, delete the file and download it again."}</p>
        </div>
      </section>

      <section aria-labelledby="needs">
        <h2 id="needs">{pt ? "Requisitos" : "Requirements"}</h2>
        <div class="prose">
          <ul>
            <li>{pt ? "Windows 10 ou Windows 11, 64 bits (x64)." : "Windows 10 or Windows 11, 64-bit (x64)."}</li>
            <li>
              {pt
                ? "DirectX 11. Sem uma placa gráfica utilizável, o Komorebi desenha com o renderizador de software do Windows."
                : "DirectX 11. Without a usable graphics card, Komorebi draws with Windows' software renderer."}
            </li>
            <li>{pt ? "Uma conta de email com IMAP e SMTP e uma palavra-passe ou palavra-passe de aplicação." : "An email account with IMAP and SMTP and a password or app password."}</li>
            <li>{pt ? "Não há início de sessão OAuth: contas que o exigem, como Gmail e Microsoft 365, não funcionam." : "There is no OAuth sign-in: accounts that require it, such as Gmail and Microsoft 365, do not work."}</li>
          </ul>
        </div>
      </section>

      <section aria-labelledby="updates">
        <h2 id="updates">{pt ? "Atualizações" : "Updates"}</h2>
        <div class="prose">
          <p>
            {pt
              ? "O Komorebi procura versões novas no GitHub e só instala uma se o SHA-256 coincidir e a assinatura Ed25519 for válida para a chave incluída na aplicação."
              : "Komorebi looks for new versions on GitHub and installs one only if its SHA-256 matches and its Ed25519 signature verifies against the key built into the app."}{" "}
            <a href={p("/docs/updates")}>{pt ? "Como as atualizações são verificadas" : "How updates are verified"}</a>.
          </p>
          {
            release && (
              <p>
                <a href={p("/changelog")}>{pt ? `O que mudou na ${release.version}` : `What changed in ${release.version}`}</a>
              </p>
            )
          }
        </div>
      </section>
    </div>
  </div>
</Base>
