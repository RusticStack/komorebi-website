---
import Base from "../layouts/Base.astro";
import { releases } from "../lib/changelog";
import { localePath, ui, type Locale } from "../lib/i18n";
import { breadcrumbs } from "../lib/seo";
import { REPO_URL } from "../lib/site";
import { formatDate, getRelease } from "../lib/upstream";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = ui(locale);
const pt = locale === "pt";
const [latest, ...older] = releases();
const release = getRelease();
const source = `${REPO_URL}/blob/${release?.tag ?? "main"}/CHANGELOG.md`;
// Komorebi 1.0 in short, in the page's language, above its English entry (from its CHANGELOG.md).
const v1 = pt
  ? {
      title: "O Komorebi 1.0 em resumo",
      points: [
        "Uma interface nova, em GPUI e DirectX 11, a seguir o Fluent 2, sobre o mesmo motor de correio. As contas, a cache, as regras, os contactos e as definições passam para a nova versão sem nada ser convertido.",
        "Um aspeto novo: o selo K cor de dióspiro como ícone da aplicação, na área de notificação e nas notificações.",
        "Teclas de acesso: mantenha Alt premida para ver a letra dos comandos principais.",
        "O calendário sai da 1.0 e deverá voltar numa versão posterior. Os convites continuam a aparecer num cartão, com Guardar .ics.",
        "A memória e o processador usados em repouso são mais altos do que na 0.7; está prevista a sua redução. Os temas de alto contraste não são suportados.",
        "Além do instalador, há um zip portátil com o komorebi.exe.",
      ],
    }
  : {
      title: "Komorebi 1.0 in short",
      points: [
        "A new interface, on GPUI and DirectX 11 and following Fluent 2, over the same mail engine. Accounts, the cache, rules, contacts and settings carry over, with nothing converted.",
        "A new look: the persimmon K seal as the app icon, in the notification area and on notifications.",
        "Access keys: hold Alt to see the letter of the main commands.",
        "The calendar is left out of 1.0 and planned to return in a later version. Invitations still show on a card, with Save .ics.",
        "Idle memory and CPU use are higher than in 0.7; reducing them is planned. High contrast themes are not supported.",
        "Besides the installer, there is a portable zip with komorebi.exe.",
      ],
    };
---

<Base
  locale={locale}
  path="/changelog"
  title={pt ? "Alterações | Komorebi" : "Changelog | Komorebi"}
  description={pt
    ? "O que mudou em cada versão do Komorebi, a começar pela mais recente, a partir do CHANGELOG.md do repositório."
    : "What changed in each Komorebi release, latest first, from the repository's CHANGELOG.md."}
  og="changelog"
  jsonLd={[breadcrumbs([{ name: "Komorebi", path: localePath(locale, "/") }, { name: t.changelog, path: localePath(locale, "/changelog") }])]}
>
  <div class="wrap">
    <article class="page">
      <h1>{t.changelog}</h1>
      <p class="lede">
        {pt ? "Cada versão, a mais recente primeiro. O texto vem do " : "Every release, latest first. The text comes from "}
        <a href={source} rel="noopener">CHANGELOG.md</a>{pt ? " e está em inglês." : "."}
        {" "}<a href="/releases.xml">RSS</a>.
      </p>
      {
        latest && (
          <section class="prose" lang="en" aria-labelledby={latest.id}>
            <div class="release-head">
              <h2 id={latest.id}>{latest.version}</h2>
              <time datetime={latest.date}>{formatDate(latest.date, locale)}</time>
            </div>
            {latest.version === "1.0.0" && (
              <div class="summary release-summary" lang={pt ? "pt-PT" : "en"}>
                <p><strong>{v1.title}</strong></p>
                <ul>
                  {v1.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </div>
            )}
            <Fragment set:html={latest.html} />
          </section>
        )
      }
      {
        older.length > 0 && (
          <section class="prose" aria-labelledby="older">
            <h2 id="older">{pt ? "Versões anteriores" : "Earlier releases"}</h2>
            {older.map((entry) => (
              <details class="older" id={entry.id}>
                <summary>
                  {entry.version}
                  <time datetime={entry.date}>{formatDate(entry.date, locale)}</time>
                </summary>
                <div lang="en" set:html={entry.html} />
              </details>
            ))}
          </section>
        )
      }
    </article>
  </div>
</Base>
